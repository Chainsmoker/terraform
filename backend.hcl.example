# Copiar a `backend.hcl` y editar con los valores del cliente.
# `backend.hcl` está en .gitignore — no se commitea.
#
# Uso:
#   terraform login                                    # una sola vez por máquina
#   terraform init -backend-config=backend.hcl         # cliente nuevo
#   terraform init -backend-config=backend.hcl -migrate-state   # migrando state local existente

organization = ""

workspaces {
  name = "cliente-x-prod"
}
